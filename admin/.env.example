# Copy to .env for a non-default setup. With no .env at all the dev server
# proxies /api and /uploads to http://localhost:4000 (see vite.config.js), which
# is what `npm run dev` in ../backend serves.

# Backend the dev server proxies to.
VITE_BACKEND_ORIGIN=http://localhost:4000

# API base the browser calls. Leave as /api to use the dev proxy, or set an
# absolute origin when the panel is served from a different host than the API —
# in which case that origin must match the backend's ADMIN_URL, which is the
# only admin origin its CORS allow-list accepts.
VITE_API_URL=/api

# Origin serving uploaded media (/uploads/**). Empty means same origin as the
# page, which is correct behind the dev proxy and in a single-host deployment.
VITE_MEDIA_URL=
