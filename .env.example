# Host addresses for local verification. Use two HTTPS domains for public access.
FRONTEND_SITE=http://muvilite.localhost
ADMIN_SITE=http://admin.muvilite.localhost
BIND_ADDRESS=127.0.0.1

# Replace each with a different value from: openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
JWT_SECRET=

# Nightly watch-trend aggregation. Cron uses the container's timezone (UTC).
ENABLE_CRON=true
WATCH_TREND_CRON="0 2 * * *"

# Video size in MiB. For higher values, also update admin/nginx.conf.
MAX_VIDEO_UPLOAD_SIZE_MB=2048
