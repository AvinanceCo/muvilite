# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/muvilite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
BCRYPT_ROUNDS=12

# Uploads
UPLOAD_PATH=src/uploads
MAX_UPLOAD_SIZE_MB=10
# Video: pre-roll creatives and a catalog title's own file. Images and audio
# use the cap above.
MAX_VIDEO_UPLOAD_SIZE_MB=2048
# HLS transcoder. Every uploaded film/clip is measured with ffprobe and
# re-encoded into an adaptive HLS ladder (360p–1080p) in the background.
# Both tools are looked up on PATH when these are empty.
FFMPEG_PATH=
FFPROBE_PATH=
# Videos encoded at once. One ffmpeg already uses every core.
TRANSCODE_CONCURRENCY=1
# x264 preset: ultrafast … veryfast … medium. Slower = smaller files, longer wait.
TRANSCODE_PRESET=veryfast
# One HTML5 game's ZIP bundle. What it may unpack to is bounded in
# src/config/constants.js (GAME_MAX_FILES, GAME_MAX_UNPACKED_BYTES).
MAX_GAME_UPLOAD_SIZE_MB=100

# Clients (CORS allow-list)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Scheduled jobs
ENABLE_CRON=false
# Legacy cron ran daily; aggregates the trailing 24h of watch history.
WATCH_TREND_CRON=0 2 * * *
